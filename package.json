{
  "name": "agent-hub",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*",
    "packages/adapters/*",
    "apps/*"
  ],
  "scripts": {
    "up": "npm run build && node apps/server/src/main.ts",
    "serve": "node apps/server/src/main.ts",
    "web": "vite",
    "dev": "node scripts/dev.mjs",
    "test": "node --test \"packages/**/*.test.ts\" \"apps/server/**/*.test.ts\" \"apps/worker/**/*.test.ts\" \"apps/web/src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:web": "tsc -p apps/web/tsconfig.json",
    "check": "npm run check:domain && npm run check:boundaries && npm run check:ports",
    "check:domain": "node scripts/check-domain-purity.mjs",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "check:ports": "node scripts/check-port-signature.mjs",
    "ci": "npm run check && npm run typecheck && npm run typecheck:web && npm test",
    "build": "npm run build --workspace @agent-hub/web",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
